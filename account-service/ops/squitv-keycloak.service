[Unit]
Description=Conta Squi TV - identidade de homologacao
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=keycloak
Group=keycloak
WorkingDirectory=/opt/keycloak
LoadCredential=keycloak-db-password:/etc/squitv-account/keycloak-db-password
Environment="JAVA_OPTS_APPEND=-Xms256m -Xmx768m"
Environment=KC_HOSTNAME=https://squitv.rafael020703.shop/auth
Environment=KC_HTTP_ENABLED=true
Environment=KC_HTTP_HOST=127.0.0.1
Environment=KC_HTTP_PORT=8080
Environment=KC_HTTP_RELATIVE_PATH=/auth
Environment=KC_HTTP_MANAGEMENT_HOST=127.0.0.1
Environment=KC_PROXY_HEADERS=xforwarded
Environment=KC_PROXY_TRUSTED_ADDRESSES=127.0.0.1
Environment=KC_DB_URL=jdbc:postgresql://squitv-db.internal:5432/squitv_identity
Environment=KC_DB_USERNAME=squitv_keycloak
Environment=KC_DB_TLS_MODE=verify-server
Environment=KC_DB_TLS_TRUST_STORE_FILE=/etc/squitv-account/postgresql-ca.pem
Environment=KC_DB_POOL_MIN_SIZE=1
Environment=KC_DB_POOL_MAX_SIZE=10
ExecStart=/usr/local/lib/squitv-account/start-keycloak.sh
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/keycloak/data

[Install]
WantedBy=multi-user.target
