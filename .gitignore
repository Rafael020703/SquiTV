# Gradle / generated build output (all modules)
.gradle/
.kotlin/
**/build/
.externalNativeBuild/
.cxx/
out/

# Local machine / IDE
*.iml
.idea/
.vscode/
local.properties
.DS_Store
Thumbs.db
Desktop.ini
/captures/

# Private signing material and environment settings
*.jks
*.keystore
*.p12
*.pfx
key.properties
keystore.properties
signing.properties
secrets.properties
.env
.env.*
!.env.example
!.env.sample

# Distribution files belong in GitHub Releases, not in the source tree
*.apk
*.aab
*.apks
*.xapk
*.idsig

# Windows installers and packaging diagnostics (publish binaries as release assets)
*.exe
*.msi
*.msix
*.msixbundle
*.appx
*.appxbundle
*.cab
*.wixobj
*.wixpdb
*.pdb
*.dmp
/desktopApp/distributions/
/desktopApp/local-data/
/desktopApp/.runtime/
# Encrypted local account data is private too.
*.dpapi

# Local diagnostics and temporary files
*.log
*.hprof
*.heapdump
*.jfr
*.trace
*.tmp
*.bak
/.artifacts/
/.agent/
/.codex/
/tmp/
/temp/
*.artifact.md
dependencies_output.txt
ksp_deps.txt
screenshot.png

# Local plans, audits, maintenance logs and AI reports; keep files on disk.
# Only durable project documentation and version notes belong in the repository.
/debug_event_matrix.md
/docs/*.md
!/docs/arquitetura-plataformas.md
!/docs/checklist-release.md
!/docs/contrato-atualizacoes.md
!/docs/desenvolvimento.md
!/docs/windows.md
/docs/releases/verificacao-*.md

# Keep Gradle Wrapper, Room schemas, source resources and release notes tracked.
